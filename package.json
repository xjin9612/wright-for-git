{
  "name": "vscode-git-workbench",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.0",
  "publisher": "xjin9612",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xjin9612/vscode-git-workbench.git"
  },
  "homepage": "https://github.com/xjin9612/vscode-git-workbench#readme",
  "bugs": {
    "url": "https://github.com/xjin9612/vscode-git-workbench/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "log",
    "graph",
    "branches",
    "history"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "gitWorkbench",
          "title": "%container.title%",
          "icon": "media/activity.svg"
        }
      ],
      "activitybar": [
        {
          "id": "gitWorkbenchBar",
          "title": "%container.activity%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "gitWorkbench": [
        {
          "type": "webview",
          "id": "gitWorkbench.log",
          "name": "%view.log%"
        }
      ],
      "gitWorkbenchBar": [
        {
          "type": "webview",
          "id": "gitWorkbench.commit",
          "name": "%view.commit%",
          "icon": "media/activity.svg"
        },
        {
          "id": "gitWorkbench.repositories",
          "name": "%view.repositories%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "gitWorkbench.refresh",
        "title": "%command.refresh%",
        "category": "Git Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "gitWorkbench.selectRepository",
        "title": "%command.selectRepository%",
        "category": "Git Workbench",
        "icon": "$(repo)"
      },
      {
        "command": "gitWorkbench.show",
        "title": "%command.show%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.showHistory",
        "title": "%command.showHistory%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.openRepository",
        "title": "%command.openRepository%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.refreshRepositories",
        "title": "%command.refresh%",
        "category": "Git Workbench",
        "icon": "$(refresh)"
      },
      {
        "command": "gitWorkbench.showAllRepositories",
        "title": "%command.showAllRepositories%",
        "category": "Git Workbench",
        "icon": "$(check-all)"
      },
      {
        "command": "gitWorkbench.fetch",
        "title": "%command.fetch%",
        "category": "Git Workbench",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "gitWorkbench.pull",
        "title": "%command.pull%",
        "category": "Git Workbench",
        "icon": "$(repo-pull)"
      },
      {
        "command": "gitWorkbench.push",
        "title": "%command.push%",
        "category": "Git Workbench",
        "icon": "$(repo-push)"
      },
      {
        "command": "gitWorkbench.stash.save",
        "title": "%command.stash.save%",
        "category": "Git Workbench",
        "icon": "$(git-stash)"
      },
      {
        "command": "gitWorkbench.diff.previousFile",
        "title": "%command.diff.previousFile%",
        "category": "Git Workbench",
        "icon": "$(arrow-left)"
      },
      {
        "command": "gitWorkbench.diff.nextFile",
        "title": "%command.diff.nextFile%",
        "category": "Git Workbench",
        "icon": "$(arrow-right)"
      },
      {
        "command": "gitWorkbench.compareWithRef",
        "title": "%command.compareWithRef%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.stashChangesIn",
        "title": "%command.stashChangesIn%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.unstash",
        "title": "%command.unstash%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.optimizeRepository",
        "title": "%command.optimizeRepository%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.resolveConflicts",
        "title": "%command.resolveConflicts%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.showCommit",
        "title": "%command.showCommit%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.unstashChanges",
        "title": "%command.unstash%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.toggleBlame",
        "title": "%command.toggleBlame%",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.openSettings",
        "title": "%command.openSettings%",
        "category": "Git Workbench",
        "icon": "$(gear)"
      },
      {
        "command": "gitWorkbench.showConsole",
        "title": "%command.showConsole%",
        "category": "Git Workbench",
        "icon": "$(output)"
      },
      {
        "command": "gitWorkbench.commit.openSettings",
        "title": "%command.openSettings%",
        "category": "Git Workbench",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitWorkbench.showAllRepositories",
          "when": "view == gitWorkbench.repositories",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkbench.selectRepository",
          "when": "view == gitWorkbench.log",
          "group": "navigation@1"
        },
        {
          "command": "gitWorkbench.refresh",
          "when": "view == gitWorkbench.log",
          "group": "navigation@2"
        },
        {
          "command": "gitWorkbench.refreshRepositories",
          "when": "view == gitWorkbench.repositories",
          "group": "navigation"
        },
        {
          "command": "gitWorkbench.openSettings",
          "when": "view == gitWorkbench.log",
          "group": "navigation@9"
        },
        {
          "command": "gitWorkbench.commit.openSettings",
          "when": "view == gitWorkbench.commit",
          "group": "navigation@9"
        },
        {
          "command": "gitWorkbench.showConsole",
          "when": "view == gitWorkbench.log",
          "group": "navigation@8"
        }
      ],
      "explorer/context": [
        {
          "submenu": "gitWorkbench.explorer",
          "group": "7_modification@90"
        }
      ],
      "editor/title/context": [
        {
          "command": "gitWorkbench.showHistory",
          "when": "resourceScheme == file",
          "group": "2_files@90"
        }
      ],
      "editor/context": [
        {
          "command": "gitWorkbench.showHistory",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@90"
        },
        {
          "command": "gitWorkbench.toggleBlame",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@91"
        }
      ],
      "commandPalette": [
        {
          "command": "gitWorkbench.showHistory",
          "when": "resourceScheme == file"
        },
        {
          "command": "gitWorkbench.openRepository",
          "when": "false"
        },
        {
          "command": "gitWorkbench.refreshRepositories",
          "when": "false"
        },
        {
          "command": "gitWorkbench.diff.previousFile",
          "when": "gitWorkbench.diffNav"
        },
        {
          "command": "gitWorkbench.diff.nextFile",
          "when": "gitWorkbench.diffNav"
        },
        {
          "command": "gitWorkbench.commit.openSettings",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "gitWorkbench.diff.previousFile",
          "when": "isInDiffEditor && resourceScheme == git-workbench && gitWorkbench.diffNav",
          "group": "navigation@11.1"
        },
        {
          "command": "gitWorkbench.diff.nextFile",
          "when": "isInDiffEditor && resourceScheme == git-workbench && gitWorkbench.diffNav",
          "group": "navigation@11.2"
        }
      ],
      "gitWorkbench.explorer": [
        {
          "command": "gitWorkbench.showHistory",
          "group": "1_history@1"
        },
        {
          "command": "gitWorkbench.compareWithRef",
          "group": "1_history@2"
        },
        {
          "command": "gitWorkbench.stashChangesIn",
          "group": "2_stash@1"
        },
        {
          "command": "gitWorkbench.unstash",
          "group": "2_stash@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Workbench",
      "properties": {
        "gitWorkbench.maxCommits": {
          "type": "number",
          "default": 50000,
          "minimum": 100,
          "description": "%config.maxCommits%",
          "maximum": 200000
        },
        "gitWorkbench.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRefresh%"
        },
        "gitWorkbench.scanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "%config.scanDepth%"
        },
        "gitWorkbench.scanExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "target",
            "build",
            "dist",
            "out",
            "bin",
            "obj",
            "vendor",
            "coverage",
            ".idea",
            ".vscode",
            ".gradle",
            ".mvn",
            ".next",
            ".venv",
            "venv",
            "__pycache__"
          ],
          "description": "%config.scanExclude%"
        },
        "gitWorkbench.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-tw"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "繁體中文"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "gitWorkbench.issueLinks": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.issueLinks%",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "%config.issueLinks.pattern%"
              },
              "url": {
                "type": "string",
                "description": "%config.issueLinks.url%"
              }
            },
            "required": [
              "pattern",
              "url"
            ]
          }
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "gitWorkbench.repositories",
        "contents": "%welcome.repositories%"
      }
    ],
    "keybindings": [
      {
        "command": "gitWorkbench.show",
        "key": "alt+9"
      },
      {
        "command": "gitWorkbench.diff.nextFile",
        "key": "ctrl+alt+pagedown",
        "mac": "cmd+alt+pagedown",
        "when": "isInDiffEditor && resourceScheme == git-workbench && gitWorkbench.diffNav"
      },
      {
        "command": "gitWorkbench.diff.previousFile",
        "key": "ctrl+alt+pageup",
        "mac": "cmd+alt+pageup",
        "when": "isInDiffEditor && resourceScheme == git-workbench && gitWorkbench.diffNav"
      },
      {
        "command": "gitWorkbench.showCommit",
        "key": "alt+0"
      }
    ],
    "submenus": [
      {
        "id": "gitWorkbench.explorer",
        "label": "%submenu.explorer%"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/webview",
    "test": "node esbuild.mjs --tests && node --test \"out/test/*.test.js\"",
    "test:ui": "node esbuild.mjs && node --test --test-concurrency=1 \"test/ui/*.test.js\"",
    "test:vscode": "node esbuild.mjs && node esbuild.mjs --vscode-tests && node out/vscode/run.js",
    "bench:vscode": "node esbuild.mjs --production && node esbuild.mjs --vscode-tests && node -e \"process.env.GWB_MODE='bench';require('./out/vscode/run.js')\"",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "~4.1.0",
    "esbuild": "~0.28.2",
    "playwright": "~1.63.0",
    "typescript": "~5.9.3"
  }
}
