{
  "name": "wright-for-git",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.3.0",
  "publisher": "xjin9612",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xjin9612/wright-for-git.git"
  },
  "homepage": "https://github.com/xjin9612/wright-for-git#readme",
  "bugs": {
    "url": "https://github.com/xjin9612/wright-for-git/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "keywords": [
    "git",
    "log",
    "graph",
    "branches",
    "history"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces%"
    }
  },
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "wright",
          "title": "%container.title%",
          "icon": "media/activity.svg"
        }
      ],
      "activitybar": [
        {
          "id": "wrightBar",
          "title": "%container.commit%",
          "icon": "media/commit.svg"
        },
        {
          "id": "wrightHistory",
          "title": "%container.history%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "wright": [
        {
          "type": "webview",
          "id": "wright.log",
          "name": "%view.log%"
        }
      ],
      "wrightBar": [
        {
          "type": "webview",
          "id": "wright.commit",
          "name": "%view.commit%",
          "icon": "media/commit.svg"
        }
      ],
      "wrightHistory": [
        {
          "type": "webview",
          "id": "wright.branches",
          "name": "%view.branches%",
          "icon": "media/activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "wright.importPatch",
        "title": "%command.importPatch%",
        "category": "Wright"
      },
      {
        "command": "wright.openSelectedFile",
        "title": "%command.openSelectedFile%",
        "category": "Wright"
      },
      {
        "command": "wright.selectInSelectedFile",
        "title": "%command.selectInSelectedFile%",
        "category": "Wright"
      },
      {
        "command": "wright.refresh",
        "title": "%command.refresh%",
        "category": "Wright",
        "icon": "$(refresh)"
      },
      {
        "command": "wright.selectRepository",
        "title": "%command.selectRepository%",
        "category": "Wright",
        "icon": "$(repo)"
      },
      {
        "command": "wright.show",
        "title": "%command.show%",
        "category": "Wright"
      },
      {
        "command": "wright.showHistory",
        "title": "%command.showHistory%",
        "category": "Wright"
      },
      {
        "command": "wright.showAllRepositories",
        "title": "%command.showAllRepositories%",
        "category": "Wright"
      },
      {
        "command": "wright.fetch",
        "title": "%command.fetch%",
        "category": "Wright",
        "icon": "$(repo-fetch)"
      },
      {
        "command": "wright.pull",
        "title": "%command.pull%",
        "category": "Wright",
        "icon": "$(repo-pull)"
      },
      {
        "command": "wright.push",
        "title": "%command.push%",
        "category": "Wright",
        "icon": "$(repo-push)"
      },
      {
        "command": "wright.stash.save",
        "title": "%command.stash.save%",
        "category": "Wright",
        "icon": "$(git-stash)"
      },
      {
        "command": "wright.diff.previousFile",
        "title": "%command.diff.previousFile%",
        "category": "Wright",
        "icon": "$(arrow-left)"
      },
      {
        "command": "wright.diff.nextFile",
        "title": "%command.diff.nextFile%",
        "category": "Wright",
        "icon": "$(arrow-right)"
      },
      {
        "command": "wright.compareWithRef",
        "title": "%command.compareWithRef%",
        "category": "Wright"
      },
      {
        "command": "wright.stashChangesIn",
        "title": "%command.stashChangesIn%",
        "category": "Wright"
      },
      {
        "command": "wright.unstash",
        "title": "%command.unstash%",
        "category": "Wright"
      },
      {
        "command": "wright.optimizeRepository",
        "title": "%command.optimizeRepository%",
        "category": "Wright"
      },
      {
        "command": "wright.resolveConflicts",
        "title": "%command.resolveConflicts%",
        "category": "Wright"
      },
      {
        "command": "wright.showCommit",
        "title": "%command.showCommit%",
        "category": "Wright"
      },
      {
        "command": "wright.unstashChanges",
        "title": "%command.unstash%",
        "category": "Wright"
      },
      {
        "command": "wright.toggleBlame",
        "title": "%command.toggleBlame%",
        "category": "Wright"
      },
      {
        "command": "wright.openSettings",
        "title": "%command.openSettings%",
        "category": "Wright",
        "icon": "$(gear)"
      },
      {
        "command": "wright.showConsole",
        "title": "%command.showConsole%",
        "category": "Wright",
        "icon": "$(output)"
      },
      {
        "command": "wright.commit.openSettings",
        "title": "%command.openSettings%",
        "category": "Wright",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "wright.refresh",
          "when": "view == wright.branches",
          "group": "navigation@1"
        },
        {
          "command": "wright.selectRepository",
          "when": "view == wright.log",
          "group": "navigation@1"
        },
        {
          "command": "wright.refresh",
          "when": "view == wright.log",
          "group": "navigation@2"
        },
        {
          "command": "wright.openSettings",
          "when": "view == wright.log",
          "group": "navigation@9"
        },
        {
          "command": "wright.commit.openSettings",
          "when": "view == wright.commit",
          "group": "navigation@9"
        },
        {
          "command": "wright.showConsole",
          "when": "view == wright.log",
          "group": "navigation@8"
        }
      ],
      "explorer/context": [
        {
          "submenu": "wright.explorer",
          "group": "7_modification@90"
        }
      ],
      "editor/title/context": [
        {
          "command": "wright.showHistory",
          "when": "resourceScheme == file",
          "group": "2_files@90"
        }
      ],
      "editor/context": [
        {
          "command": "wright.showHistory",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@90"
        },
        {
          "command": "wright.toggleBlame",
          "when": "resourceScheme == file",
          "group": "9_cutcopypaste@91"
        }
      ],
      "commandPalette": [
        {
          "command": "wright.openSelectedFile",
          "when": "false"
        },
        {
          "command": "wright.selectInSelectedFile",
          "when": "false"
        },
        {
          "command": "wright.showHistory",
          "when": "resourceScheme == file"
        },
        {
          "command": "wright.diff.previousFile",
          "when": "wright.diffNav"
        },
        {
          "command": "wright.diff.nextFile",
          "when": "wright.diffNav"
        },
        {
          "command": "wright.commit.openSettings",
          "when": "false"
        },
        {
          "command": "wright.stashChangesIn",
          "when": "false"
        },
        {
          "command": "wright.unstash",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "wright.diff.previousFile",
          "when": "isInDiffEditor && resourceScheme == wright && wright.diffNav",
          "group": "navigation@11.1"
        },
        {
          "command": "wright.diff.nextFile",
          "when": "isInDiffEditor && resourceScheme == wright && wright.diffNav",
          "group": "navigation@11.2"
        }
      ],
      "wright.explorer": [
        {
          "command": "wright.showHistory",
          "group": "1_history@1"
        },
        {
          "command": "wright.compareWithRef",
          "group": "1_history@2"
        },
        {
          "command": "wright.stashChangesIn",
          "group": "2_stash@1"
        },
        {
          "command": "wright.unstash",
          "group": "2_stash@2"
        },
        {
          "command": "wright.importPatch",
          "when": "resourceExtname =~ /^\\.(patch|diff)$/i",
          "group": "2_stash@3"
        }
      ]
    },
    "configuration": {
      "title": "Wright for Git",
      "properties": {
        "wright.maxCommits": {
          "type": "number",
          "default": 50000,
          "minimum": 100,
          "description": "%config.maxCommits%",
          "maximum": 200000
        },
        "wright.defaultFavoriteBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master"
          ],
          "markdownDescription": "%config.defaultFavoriteBranches%"
        },
        "wright.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRefresh%"
        },
        "wright.scanDepth": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 10,
          "description": "%config.scanDepth%"
        },
        "wright.scanExclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            "target",
            "build",
            "dist",
            "out",
            "bin",
            "obj",
            "vendor",
            "coverage",
            ".idea",
            ".vscode",
            ".gradle",
            ".mvn",
            ".next",
            ".venv",
            "venv",
            "__pycache__"
          ],
          "description": "%config.scanExclude%"
        },
        "wright.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "zh-tw"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "繁體中文"
          ],
          "default": "auto",
          "description": "%config.language%"
        },
        "wright.issueLinks": {
          "type": "array",
          "default": [],
          "markdownDescription": "%config.issueLinks%",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "%config.issueLinks.pattern%"
              },
              "url": {
                "type": "string",
                "description": "%config.issueLinks.url%"
              }
            },
            "required": [
              "pattern",
              "url"
            ]
          }
        }
      }
    },
    "keybindings": [
      {
        "command": "wright.openSelectedFile",
        "key": "f4",
        "when": "wright.fileTreeFocus"
      },
      {
        "command": "wright.selectInSelectedFile",
        "key": "alt+f1",
        "when": "wright.fileTreeFocus"
      },
      {
        "command": "wright.show",
        "key": "alt+9"
      },
      {
        "command": "wright.diff.nextFile",
        "key": "ctrl+alt+pagedown",
        "mac": "cmd+alt+pagedown",
        "when": "isInDiffEditor && resourceScheme == wright && wright.diffNav"
      },
      {
        "command": "wright.diff.previousFile",
        "key": "ctrl+alt+pageup",
        "mac": "cmd+alt+pageup",
        "when": "isInDiffEditor && resourceScheme == wright && wright.diffNav"
      },
      {
        "command": "wright.showCommit",
        "key": "alt+0"
      }
    ],
    "submenus": [
      {
        "id": "wright.explorer",
        "label": "%submenu.explorer%"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/webview",
    "test": "node esbuild.mjs --tests && node --test \"out/test/*.test.js\"",
    "pretest:ui": "playwright install chromium",
    "test:ui": "node esbuild.mjs && node --test --test-concurrency=1 \"test/ui/*.test.js\"",
    "test:vscode": "node esbuild.mjs && node esbuild.mjs --vscode-tests && node out/vscode/run.js",
    "bench:vscode": "node esbuild.mjs --production && node esbuild.mjs --vscode-tests && node -e \"process.env.GWB_MODE='bench';require('./out/vscode/run.js')\"",
    "check": "npm run typecheck && npm test && npm run test:ui && npm run test:vscode && npm run package",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "~22.20.5",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "~4.1.0",
    "esbuild": "~0.28.2",
    "playwright": "~1.63.0",
    "typescript": "~5.9.3"
  }
}
